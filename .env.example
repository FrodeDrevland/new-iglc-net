# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
# Leave out to use SQLite (db.sqlite3). With Docker Compose this is set for you.
# DATABASE_URL=postgres://iglc:iglc@localhost:5432/iglc
# Where the old /Content/ files are stored (blob container URL)
# LEGACY_CONTENT_URL=https://iglcstorage.blob.core.windows.net/content
