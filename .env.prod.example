# Copy to .env.prod on the server. Never commit .env.prod.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=iglc.drevland.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://iglc.drevland.net
SITE_URL=https://iglc.drevland.net
# A preview copy must not be indexed by search engines (robots.txt and X-Robots-Tag).
SITE_NOINDEX=1
# Serve uploaded images and documents from Django (fine for a preview).
SERVE_MEDIA=1
POSTGRES_PASSWORD=replace-with-another-long-random-string
# Docker network that SWAG is on, and where the data lives on Unraid.
PROXY_NETWORK=proxynet
APPDATA=/mnt/user/appdata/iglc
# The conference websites are at conference.<the site's host>, here conference.iglc.drevland.net
# (added to the allowed hosts automatically). Set CONFERENCE_HOST only to use another name.
# CONFERENCE_HOST=conference.iglc.drevland.net
# Email: leave AZURE_EMAIL_ENDPOINT and EMAIL_HOST unset. The preview's database is a copy of
# production with the authors' addresses, so it must never send real mail: mails are written to
# the log (docker logs iglc-web).
